{
  "name": "browser-manager-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend orchestrator for the headless browser manager",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "playwright": "^1.60.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}