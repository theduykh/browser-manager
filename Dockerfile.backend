# Playwright base image (đã có Chromium + deps)
FROM mcr.microsoft.com/playwright:v1.50.0-noble

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Ho_Chi_Minh

# System deps cho Xvfb / VNC / websockify
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        socat \
        sqlite3 \
        procps \
        psmisc \
        net-tools \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# noVNC trên Ubuntu cài vào /usr/share/novnc, tạo symlink cho tiện
RUN ln -sf /usr/share/novnc /opt/novnc || true

WORKDIR /app

# Cài deps trước để tận dụng layer cache
COPY backend/package.json backend/package-lock.json* ./backend/
RUN cd backend && npm install

# Copy source
COPY backend ./backend
COPY scripts ./scripts

# Build TypeScript
RUN cd backend && npm run build

# profiles_data sẽ là named volume; tạo sẵn folder trong image
RUN mkdir -p /app/profiles_data && chmod 777 /app/profiles_data

EXPOSE 3000
EXPOSE 6001-6050
EXPOSE 9223-9272

# tini làm PID 1 để reap zombie processes
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "backend/dist/main.js"]
