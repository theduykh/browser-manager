# Base: Node slim (Chromium is installed by Playwright CLI below — not by MS image)
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Ho_Chi_Minh

# Pin Playwright's browser cache to /ms-playwright so backend's resolveChromiumBin()
# (which scans /ms-playwright for a `chrome` binary) keeps working unchanged.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# System deps cho Xvfb / VNC / websockify + tini.
# Playwright `install --with-deps` sẽ tự kéo các shared libs Chromium cần.
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        socat \
        sqlite3 \
        procps \
        psmisc \
        net-tools \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# noVNC trên Debian cài vào /usr/share/novnc, tạo symlink cho tiện
RUN ln -sf /usr/share/novnc /opt/novnc || true

WORKDIR /app

# Cài deps trước để tận dụng layer cache
COPY backend/package.json backend/package-lock.json* ./backend/
RUN cd backend && npm install

# Cài Chromium qua Playwright CLI (phiên bản theo `playwright` trong package.json).
# --with-deps cài kèm system libraries Chromium cần trên Debian.
RUN cd backend && npx playwright install --with-deps chromium

# Copy source
COPY backend ./backend
COPY scripts ./scripts

# Build TypeScript
RUN cd backend && npm run build

# profiles_data sẽ là named volume; tạo sẵn folder trong image
RUN mkdir -p /app/profiles_data && chmod 777 /app/profiles_data

EXPOSE 3000
EXPOSE 6001-6050
EXPOSE 9223-9272

# tini làm PID 1 để reap zombie processes
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "backend/dist/main.js"]
